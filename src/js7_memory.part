
/* ================= MODE: MEMORY (Kaartjes zoeken) =================
   24 cards on a 6x4 table: the 10 category pairs, D.pins pins (a pin costs a life) and
   ballonnetjes to fill the rest. All cards are shown for D.peek frames at the start. A mismatch
   stays visible for D.flipBack frames (flipping another card closes it early); D.missBudget
   mismatches cost a life. After the last pair the kassa appears: tap it or press space. */
const Memory=(()=>{
  const MC=6, MR=4, CS=96, GAP=12, X0=(W-(MC*CS+(MC-1)*GAP))/2, Y0=100;
  const MM={cards:[],open:[],backT:0,misses:0,missTotal:0,peekT:0,cur:0,ptr:false,kassa:false};
  let D=null;
  const px=n=>X0+(n%MC)*(CS+GAP)+CS/2, py=n=>Y0+Math.floor(n/MC)*(CS+GAP)+CS/2;
  function deal(){
    const deck=[]; CATS.forEach((c,i)=>deck.push({k:'cat',i},{k:'cat',i}));
    for(let n=0;n<D.pins;n++) deck.push({k:'pin',i:-1});
    while(deck.length<MC*MR) deck.push({k:'coin',i:-1});
    for(let n=deck.length-1;n>0;n--){ const j=Math.floor(Math.random()*(n+1)); [deck[n],deck[j]]=[deck[j],deck[n]]; }
    MM.cards=deck.map(c=>({...c,up:false,done:false,f:1}));
    MM.open=[]; MM.backT=0; MM.misses=0; MM.missTotal=0; MM.peekT=D.peek; MM.cur=0; MM.kassa=false;
  }
  function closeOpen(){ for(const n of MM.open) if(!MM.cards[n].done) MM.cards[n].up=false; MM.open=[]; MM.backT=0; }
  function flip(n){
    if(deadT||MM.peekT>0||MM.kassa||MM.misses>=D.missBudget) return; const c=MM.cards[n]; if(!c||c.up) return;
    if(MM.open.length===2) closeOpen();
    c.up=true; SFX.rotate();
    if(c.k==='pin'){ c.done=true; closeOpen(); die(px(n),py(n)); return; }
    if(c.k==='coin'){ c.done=true; tot.coins++; collectCoin(px(n),py(n)); return; }
    MM.open.push(n); if(MM.open.length<2) return;
    const [a,b]=MM.open;
    if(MM.cards[a].i===MM.cards[b].i){ MM.cards[a].done=MM.cards[b].done=true; MM.open=[]; collectItem(c.i,(px(a)+px(b))/2,(py(a)+py(b))/2); if(collected>=tot.items) MM.kassa=true; }
    else { MM.misses++; MM.missTotal++; MM.backT=D.flipBack; SFX.lock(); }
  }
  function step(){
    if(deadT){ afterDeath(); return; }
    for(const c of MM.cards){ const goal=(c.up||MM.peekT>0)?1:0; c.f+=Math.sign(goal-c.f)*Math.min(0.125,Math.abs(goal-c.f)); }
    if(MM.peekT>0){ if(--MM.peekT===0){ SFX.flag(); toast('Zoek de paren!'); } return; }
    if(MM.backT>0&&--MM.backT===0) closeOpen();
    if(MM.misses>=D.missBudget&&MM.backT===0){ closeOpen(); die(W/2,H/2); } // after the mismatch has been seen
  }
  const hit=(x,y)=>{ for(let n=0;n<MM.cards.length;n++) if(Math.abs(x-px(n))<=CS/2&&Math.abs(y-py(n))<=CS/2) return n; return -1; };
  function moveCur(dx,dy){ MM.ptr=false; const c=MM.cur%MC, r=Math.floor(MM.cur/MC); MM.cur=Math.min(MR-1,Math.max(0,r+dy))*MC+Math.min(MC-1,Math.max(0,c+dx)); SFX.move(); }
  function drawBack(){ ctx.fillStyle='#D20000'; rr(-CS/2,-CS/2,CS,CS,10); ctx.fill(); ctx.strokeStyle='#fff'; ctx.lineWidth=3; rr(-CS/2+6,-CS/2+6,CS-12,CS-12,7); ctx.stroke();
    ctx.fillStyle='rgba(255,255,255,.9)';
    if(THEME==='sint'){ ctx.beginPath(); ctx.moveTo(-15,20); ctx.lineTo(-16,-4); ctx.quadraticCurveTo(-12,-22,0,-31); ctx.quadraticCurveTo(12,-22,16,-4); ctx.lineTo(15,20); ctx.closePath(); ctx.fill(); ctx.fillStyle='#FCB900'; ctx.fillRect(-15,13,30,5); } // a mitre
    else if(THEME==='pasen'){ ctx.beginPath(); ctx.ellipse(0,-3,16,21,0,0,Math.PI*2); ctx.fill(); ctx.fillStyle='#FCB900'; ctx.beginPath(); for(let x=-16;x<=16;x+=4) ctx.lineTo(x,10+((x/4)%2?-3:0)); ctx.lineTo(14,14); ctx.lineTo(-14,14); ctx.closePath(); ctx.fill(); } // an Easter egg
    else if(THEME==='carnaval'){ ctx.beginPath(); ctx.moveTo(-22,-14); ctx.quadraticCurveTo(0,-22,22,-14); ctx.quadraticCurveTo(24,6,8,4); ctx.quadraticCurveTo(0,-4,-8,4); ctx.quadraticCurveTo(-24,6,-22,-14); ctx.fill(); ctx.fillStyle='#D20000'; ctx.beginPath(); ctx.ellipse(-10,-8,5,3.5,0,0,Math.PI*2); ctx.ellipse(10,-8,5,3.5,0,0,Math.PI*2); ctx.fill(); } // a carnival mask
    else if(THEME==='kerst'){ ctx.beginPath(); ctx.arc(0,-2,18,0,Math.PI*2); ctx.fill(); ctx.fillStyle='#FCB900'; ctx.fillRect(-5,-25,10,6); ctx.strokeStyle='#FCB900'; ctx.lineWidth=1.5; ctx.beginPath(); ctx.arc(0,-28,3,0,Math.PI*2); ctx.stroke(); } // a bauble
    else { ctx.beginPath(); ctx.ellipse(0,-8,17,19,0,0,Math.PI*2); ctx.fill(); ctx.fillStyle='#D20000'; ctx.beginPath(); ctx.moveTo(-4,11); ctx.lineTo(4,11); ctx.lineTo(0,16); ctx.closePath(); ctx.fill();
      ctx.strokeStyle='rgba(255,255,255,.9)'; ctx.lineWidth=1.5; ctx.beginPath(); ctx.moveTo(0,15); ctx.quadraticCurveTo(-6,24,2,32); ctx.stroke(); }
    ctx.fillStyle='#D20000'; ctx.font='900 22px Grandstander, Impact, sans-serif'; ctx.textAlign='center'; ctx.fillText('?',0,0); ctx.textAlign='left'; }
  function drawFront(c,t){ ctx.fillStyle='#fff'; rr(-CS/2,-CS/2,CS,CS,10); ctx.fill(); ctx.strokeStyle=c.k==='pin'?'#8f97a3':c.k==='coin'?'#E5A700':'#D20000'; ctx.lineWidth=3; rr(-CS/2,-CS/2,CS,CS,10); ctx.stroke();
    if(c.k==='cat'){ const im=IMG[c.i]; if(im.complete&&im.naturalWidth){ ctx.save(); rr(-CS/2+7,-CS/2+7,CS-14,CS-14,6); ctx.clip(); ctx.drawImage(im,-CS/2+7,-CS/2+7,CS-14,CS-14); ctx.restore(); }
      else { ctx.fillStyle='#1A1414'; ctx.font='700 11px Roboto, sans-serif'; ctx.textAlign='center'; ctx.fillText(CATS[c.i].name,0,4); ctx.textAlign='left'; } }
    else if(c.k==='pin') drawPin(0,2,2);
    else { ctx.save(); ctx.scale(2,2); drawCoin(0,-4,t); ctx.restore(); } }
  function draw(t){
    ctx.fillStyle='#FFF6F3'; ctx.fillRect(0,0,W,H); drawBunting(t,0,false);
    ctx.fillStyle='rgba(210,0,0,.06)'; rr(X0-18,Y0-18,MC*CS+(MC-1)*GAP+36,MR*CS+(MR-1)*GAP+36,16); ctx.fill();
    ctx.save(); let sx=0,sy=0; if(shakeT>0){ sx=(Math.random()-.5)*shakeT*0.8; sy=(Math.random()-.5)*shakeT*0.8; } ctx.translate(sx,sy);
    MM.cards.forEach((c,n)=>{ const s=Math.max(0.04,Math.abs(1-2*c.f)); ctx.save(); ctx.translate(px(n),py(n)); ctx.scale(s,1);
      if(c.done&&c.k==='cat') ctx.globalAlpha=0.55; if(c.f>0.5) drawFront(c,t); else drawBack(); ctx.restore(); });
    if(!MM.ptr&&!MM.peekT&&!MM.kassa){ ctx.strokeStyle='#FCB900'; ctx.lineWidth=5; rr(px(MM.cur)-CS/2-6,py(MM.cur)-CS/2-6,CS+12,CS+12,13); ctx.stroke(); }
    // side panels: misses (left) and pairs (right)
    ctx.textAlign='center'; const lx=X0/2, rx=W-X0/2;
    ctx.fillStyle='#5a4444'; ctx.font='700 15px Roboto, sans-serif'; ctx.fillText('Misgrepen',lx,Y0+40); ctx.fillText('Paren',rx,Y0+40);
    ctx.fillStyle=MM.misses>=D.missBudget-2?'#D20000':'#1A1414'; ctx.font='900 34px Grandstander, Impact, sans-serif'; ctx.fillText(MM.misses+'/'+D.missBudget,lx,Y0+82);
    ctx.fillStyle='#1A1414'; ctx.fillText(collected+'/'+tot.items,rx,Y0+82);
    ctx.fillStyle='#5a4444'; ctx.font='400 12px Roboto, sans-serif'; ctx.fillText('dan kost het',lx,Y0+104); ctx.fillText('een ballon',lx,Y0+119);
    if(MM.peekT>0){ ctx.fillStyle='#D20000'; rr(lx-62,Y0+170,124,150,14); ctx.fill(); ctx.fillStyle='#fff'; ctx.font='900 19px Grandstander, Impact, sans-serif'; ctx.fillText('Onthoud',lx,Y0+204); ctx.fillText('ze goed!',lx,Y0+228);
      ctx.font='900 52px Grandstander, Impact, sans-serif'; ctx.fillText(String(Math.ceil(MM.peekT/60)),lx,Y0+296); }
    ctx.textAlign='left';
    if(MM.kassa){ ctx.fillStyle='rgba(255,246,243,.8)'; ctx.fillRect(X0-18,Y0-18,MC*CS+(MC-1)*GAP+36,MR*CS+(MR-1)*GAP+36); drawKassa(W/2-32,H/2-40,t);
      ctx.fillStyle='#D20000'; ctx.font='900 22px Grandstander, Impact, sans-serif'; ctx.textAlign='center'; ctx.fillText('Tik op de kassa of druk op spatie',W/2,H/2+70); ctx.textAlign='left'; }
    drawFx(); ctx.restore();
  }
  return {
    buttons:[],
    init(){ D=LV.diff; deal(); }, respawn(){ closeOpen(); MM.misses=0; invT=0; }, step, draw,
    key(code,down){ if(!down) return; const m={ArrowLeft:[-1,0],KeyA:[-1,0],ArrowRight:[1,0],KeyD:[1,0],ArrowUp:[0,-1],KeyW:[0,-1],ArrowDown:[0,1],KeyS:[0,1]}[code];
      if(m){ moveCur(m[0],m[1]); return; } if(code==='Space'||code==='KeyZ'){ if(MM.kassa) win(); else flip(MM.cur); } },
    touch(){}, tap(x,y){ MM.ptr=true; if(MM.kassa){ win(); return; } const n=hit(x,y); if(n>=0){ MM.cur=n; flip(n); } },
    stats(){ return [['Misgrepen',MM.missTotal],['Ballonnetjes',coinsGot],['Ballonnen over',lives]]; },
    debug(){ return {MM,diff:D,layout:{MC,MR,CS,GAP,X0,Y0}}; },
  };
})();
