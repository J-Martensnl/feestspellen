
/* ================= MODE: CATCH (Winkelmandje) =================
   The clown walks along the shop floor with a basket above the head. Ballonnetjes, the category cards
   and pins fall from the shelves. A card or coin that crosses the basket rim (LINE) within CATCH_W of the
   clown is caught; a pin that crosses it within PIN_W pops a balloon. A missed card falls again later, so a
   level is always winnable. After the tenth card the kassa rolls in: walk into it.
   Objects fall straight down at a fixed speed per object, swaying sideways as a function of their height
   only (x = x0 + sway*26*sin(ph + y*0.025)), so where and when they cross LINE is known in advance (the bot
   uses that). Knobs: fall0/fallMax (speed of the first/last card), spawnEvery, pinShare, sway. */
const Catch=(()=>{
  const FLOOR=H-56, S=1.25, LINE=FLOOR-88, CATCH_W=30, PIN_W=24, SPD=5, TOP=58;
  const CT={x:W/2,target:null,face:1,walkP:0,vx:0,falling:[],missed:[],spawnT:0,spawnN:0,kassa:null,caught:0,t:0};
  let D=null;
  const speedNow=()=>D.fall0+(D.fallMax-D.fall0)*Math.min(1,collected/9);
  const xAt=(o,y)=>o.x0+o.sway*26*Math.sin(o.ph+y*0.025);
  const clampX=x=>Math.max(40,Math.min(W-40,x));
  function spawn(){
    const n=CT.spawnN++, v=speedNow(), ph=Math.random()*6, sway=D.sway*(0.5+Math.random()*0.5);
    const cardFalling=CT.falling.some(o=>o.kind==='card');
    let kind='coin', i=-1;
    if(collected<tot.items&&!cardFalling&&n%3===0){ // every third drop is a card: a missed one first, else the next one still to get
      const want=CT.missed.length?CT.missed.shift():items.find(it=>!it.got&&!CT.falling.some(o=>o.i===it.i));
      if(want!=null){ kind='card'; i=typeof want==='number'?want:want.i; } }
    if(kind==='coin'&&Math.random()<D.pinShare) kind='pin';
    // most pins aim at where the clown is now, so standing still is never safe
    const x0=kind==='pin'&&Math.random()<0.6?clampX(CT.x+(Math.random()-0.5)*30):70+Math.random()*(W-140);
    if(kind==='coin') tot.coins++;
    CT.falling.push({kind,i,x0,x:x0,y:TOP,v,ph,sway:kind==='card'?sway*0.6:sway});
  }
  function step(){
    if(deadT){ afterDeath(); return; }
    CT.t++;
    // walk: held keys win over a tap target
    let dir=0; if(keys.l&&!keys.r) dir=-1; else if(keys.r&&!keys.l) dir=1;
    if(dir) CT.target=null; else if(CT.target!=null){ const dx=CT.target-CT.x; if(Math.abs(dx)<=SPD){ CT.x=CT.target; CT.target=null; } else dir=Math.sign(dx); }
    CT.vx=dir*SPD; CT.x=clampX(CT.x+CT.vx); if(dir) CT.face=dir;
    if(CT.vx) CT.walkP=(CT.walkP+SPD*0.022)%1;
    if(CT.kassa){ if(CT.kassa.x>CT.kassa.goal) CT.kassa.x=Math.max(CT.kassa.goal,CT.kassa.x-6);
      if(Math.abs(CT.x-(CT.kassa.x+32))<44&&CT.kassa.x===CT.kassa.goal){ win(); return; } }
    else if(++CT.spawnT>=D.spawnEvery){ CT.spawnT=0; spawn(); }
    for(let k=CT.falling.length-1;k>=0;k--){ const o=CT.falling[k], py=o.y; o.y+=o.v; o.x=xAt(o,o.y);
      if(py<LINE&&o.y>=LINE){ const dx=Math.abs(o.x-CT.x);
        if(o.kind==='pin'&&dx<PIN_W){ CT.falling.splice(k,1); die(CT.x,FLOOR-80); return; }
        if(o.kind!=='pin'&&dx<CATCH_W){ CT.falling.splice(k,1); CT.caught++; if(o.kind==='card') collectItem(o.i,CT.x,LINE); else collectCoin(CT.x,LINE); continue; } }
      if(o.y>FLOOR+10){ CT.falling.splice(k,1); if(o.kind==='card'&&!items[o.i].got) CT.missed.push(o.i); } }
    if(collected>=tot.items&&!CT.kassa){ CT.kassa={x:W+40,goal:CT.x<W/2?W-130:60}; CT.falling=CT.falling.filter(o=>o.kind!=='pin'); }
  }
  function respawn(){ CT.falling=CT.falling.filter(o=>o.kind!=='pin'); CT.x=W/2; CT.target=null; CT.spawnT=0; }
  function drawFalling(o,t){
    if(o.kind==='card') drawCard(o.i,o.x,o.y,0,0,40);
    else if(o.kind==='coin') drawCoin(o.x,o.y,0,0);
    else { ctx.save(); ctx.translate(o.x,o.y); ctx.rotate(Math.PI+Math.sin(t*0.1+o.ph)*0.15); drawPin(0,0,1.15); ctx.restore(); } }
  function draw(t){
    const g=ctx.createLinearGradient(0,0,0,H); g.addColorStop(0,'#FFF6F3'); g.addColorStop(1,'#FFE4DE'); ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
    drawShelvesBg(0,false); drawBunting(t,0,false);
    ctx.save(); let sx=0,sy=0; if(shakeT>0){ sx=(Math.random()-.5)*shakeT*0.8; sy=(Math.random()-.5)*shakeT*0.8; } ctx.translate(sx,sy);
    ctx.fillStyle='#1A1414'; ctx.fillRect(0,FLOOR,W,H-FLOOR); ctx.fillStyle='#D20000'; ctx.fillRect(0,FLOOR,W,5); ctx.fillStyle='#FF7B7B'; ctx.fillRect(0,FLOOR,W,2);
    for(let x=0;x<W;x+=64){ ctx.fillStyle='rgba(255,255,255,.06)'; ctx.fillRect(x,FLOOR+12,32,H-FLOOR-12); }
    // where the next card will land: a soft shadow on the floor
    for(const o of CT.falling) if(o.kind==='card'){ const lx=xAt(o,LINE); ctx.fillStyle='rgba(210,0,0,'+(0.12+0.2*o.y/LINE)+')'; ctx.beginPath(); ctx.ellipse(lx,FLOOR+3,22,4,0,0,Math.PI*2); ctx.fill(); }
    if(CT.kassa) drawKassa(CT.kassa.x,FLOOR-64,t);
    for(const o of CT.falling) drawFalling(o,t);
    if(!deadT&&!flicker()) drawClownHero(CT.x,FLOOR,S,{face:CT.face,p:CT.walkP,walking:!!CT.vx,carry:true,lk:{x:CT.face*0.5,y:-1},t});
    if(CT.kassa&&CT.kassa.x===CT.kassa.goal){ ctx.fillStyle='#D20000'; ctx.font='900 20px Grandstander, sans-serif'; ctx.textAlign='center'; ctx.fillText('Loop naar de kassa →'.replace('→',CT.kassa.goal<W/2?'←':'→'),W/2,FLOOR-140); ctx.textAlign='left'; }
    drawFx(); ctx.restore();
  }
  return {
    buttons:[{id:'l',label:'◀',side:'l'},{id:'r',label:'▶',side:'r'}],
    init(){ D=LV.diff; Object.assign(CT,{x:W/2,target:null,face:1,walkP:0,vx:0,falling:[],missed:[],spawnT:D.spawnEvery-30,spawnN:0,kassa:null,caught:0,t:0}); tot.coins=0; },
    respawn, step, draw,
    key(code,down){ if(down&&['ArrowLeft','ArrowRight','KeyA','KeyD'].includes(code)) CT.target=null; },
    touch(id,down){ if(id==='l') keys.l=down; else if(id==='r') keys.r=down; },
    tap(x){ if(state!=='play'||deadT) return; CT.target=clampX(x); },
    stats(){ return [['Gevangen',CT.caught],['Ballonnetjes',coinsGot],['Ballonnen over',lives]]; },
    debug(){ return {CT,diff:D,consts:{FLOOR,LINE,CATCH_W,PIN_W,SPD,TOP,W,H},xAt}; },
  };
})();
