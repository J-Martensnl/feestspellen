function drawCoin(x,y,t,ph=0){ y=y+Math.sin(t*0.06+ph)*3; ctx.strokeStyle='#b28a00'; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(x,y+7); ctx.quadraticCurveTo(x+3,y+12,x-1,y+16); ctx.stroke(); const g=ctx.createRadialGradient(x-2,y-3,1,x,y,8); g.addColorStop(0,'#FFE680'); g.addColorStop(1,'#E5A700'); ctx.fillStyle=g; ctx.beginPath(); ctx.ellipse(x,y,7,8.5,0,0,Math.PI*2); ctx.fill(); ctx.fillStyle='rgba(255,255,255,.7)'; ctx.beginPath(); ctx.ellipse(x-2.5,y-3,2,3,-0.5,0,Math.PI*2); ctx.fill(); }
function drawCard(i,x,y,t,ph=0,s=44,night=false){ y=y+Math.sin(t*0.05+ph)*4; const pulse=0.5+0.5*Math.sin(t*0.1+ph);
  ctx.save(); ctx.shadowColor=night?'rgba(255,200,120,'+(0.5+pulse*0.4)+')':'rgba(210,0,0,'+(0.35+pulse*0.4)+')'; ctx.shadowBlur=14+pulse*10; ctx.fillStyle='#fff'; rr(x-s/2,y-s/2,s,s,8); ctx.fill(); ctx.restore();
  ctx.strokeStyle='#D20000'; ctx.lineWidth=3; rr(x-s/2,y-s/2,s,s,8); ctx.stroke();
  const im=IMG[i]; if(im.complete&&im.naturalWidth){ ctx.save(); rr(x-s/2+5,y-s/2+5,s-10,s-10,4); ctx.clip(); ctx.drawImage(im,x-s/2+5,y-s/2+5,s-10,s-10); ctx.restore(); }
  const sa=t*0.15+ph; ctx.fillStyle='#fff'; ctx.save(); ctx.translate(x+s/2-4,y-s/2+4); ctx.rotate(sa); const r=3+pulse*3; ctx.beginPath(); ctx.moveTo(0,-r); ctx.lineTo(r*.3,-r*.3); ctx.lineTo(r,0); ctx.lineTo(r*.3,r*.3); ctx.lineTo(0,r); ctx.lineTo(-r*.3,r*.3); ctx.lineTo(-r,0); ctx.lineTo(-r*.3,-r*.3); ctx.closePath(); ctx.fill(); ctx.restore(); }
function drawPin(x,y,scale=1){ ctx.save(); ctx.translate(x,y); ctx.scale(scale,scale); ctx.strokeStyle='#8f97a3'; ctx.lineWidth=3; ctx.beginPath(); ctx.moveTo(0,12); ctx.lineTo(0,-11); ctx.stroke(); ctx.strokeStyle='#dfe4ea'; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(-1,12); ctx.lineTo(-1,-10); ctx.stroke(); ctx.fillStyle='#e8ecf0'; ctx.beginPath(); ctx.moveTo(-2.5,-9); ctx.lineTo(0,-16); ctx.lineTo(2.5,-9); ctx.closePath(); ctx.fill(); ctx.fillStyle='#D20000'; ctx.beginPath(); ctx.arc(0,12,5.5,0,Math.PI*2); ctx.fill(); ctx.fillStyle='rgba(255,255,255,.5)'; ctx.beginPath(); ctx.arc(-2,10,1.8,0,Math.PI*2); ctx.fill(); ctx.restore(); }
function drawKassa(x,y,t){
  ctx.fillStyle='rgba(0,0,0,.1)'; rr(x-4,y+T*2-4,72,6,3); ctx.fill();
  ctx.fillStyle='#1A1414'; rr(x-2,y+30,68,34,4); ctx.fill(); ctx.fillStyle='#D20000'; ctx.fillRect(x-2,y+30,68,5);
  for(let i=0;i<68;i+=12){ ctx.fillStyle=(i/12)%2?'#fff':'#D20000'; ctx.fillRect(x-2+i,y+58,Math.min(12,68-i),6); }
  ctx.fillStyle='#fff'; rr(x+8,y+4,48,28,5); ctx.fill(); ctx.strokeStyle='#1A1414'; ctx.lineWidth=2; rr(x+8,y+4,48,28,5); ctx.stroke();
  ctx.fillStyle='#8ED1FC'; rr(x+14,y+8,20,12,2); ctx.fill(); ctx.fillStyle='#1A1414'; ctx.font='bold 8px Roboto, sans-serif'; ctx.fillText('€'+(collected*100+coinsGot*10),x+16,y+17);
  ctx.fillStyle='#D20000'; for(let r=0;r<2;r++) for(let c=0;c<3;c++){ ctx.fillRect(x+38+c*6,y+9+r*6,4,4); }
  ctx.fillStyle='#1A1414'; ctx.fillRect(x+12,y+24,40,4);
  const bob=Math.sin(t*0.05)*2; ctx.save(); ctx.translate(x+32,y-14+bob); ctx.rotate(-0.05); ctx.fillStyle='#D20000'; rr(-30,-11,60,22,6); ctx.fill(); ctx.fillStyle='#9E0000'; ctx.fillRect(-30,9,60,3); ctx.fillStyle='#fff'; ctx.font='900 15px Grandstander, Impact, sans-serif'; ctx.textAlign='center'; ctx.fillText('KASSA',0,6); ctx.textAlign='left'; ctx.restore();
  if(THEME==='sint'){ // a chocolate letter J on the left, a shoe with a present on the right
    ctx.save(); ctx.translate(x-20,y+62); ctx.rotate(-0.08); ctx.font='900 34px Grandstander, Impact, sans-serif'; ctx.textAlign='center'; ctx.lineWidth=3; ctx.strokeStyle='#3E1F0D'; ctx.strokeText('J',0,0); ctx.fillStyle='#7B4A26'; ctx.fillText('J',0,0); ctx.fillStyle='rgba(255,255,255,.25)'; ctx.fillRect(-3,-22,2,14); ctx.restore();
    ctx.save(); ctx.translate(x+84,y+64); ctx.fillStyle='#1A1414'; ctx.beginPath(); ctx.moveTo(-14,0); ctx.lineTo(-14,-9); ctx.quadraticCurveTo(-12,-13,-6,-12); ctx.lineTo(4,-8); ctx.quadraticCurveTo(14,-7,14,0); ctx.closePath(); ctx.fill();
    ctx.fillStyle='#D20000'; ctx.fillRect(-12,-24,13,12); ctx.fillStyle='#FCB900'; ctx.fillRect(-6.5,-24,2,12); ctx.fillRect(-12,-19,13,2); ctx.restore(); }
  else if(THEME==='pasen'){ // a nest with three Easter eggs on the right
    ctx.save(); ctx.translate(x+86,y+62); [[-7,-6,0],[6,-7,2],[0,-10,3]].forEach(([ex,ey,c],i)=>{ ctx.fillStyle=PAAS[c]; ctx.beginPath(); ctx.ellipse(ex,ey,5,6.5,i?0.2:-0.2,0,Math.PI*2); ctx.fill(); });
    ctx.fillStyle='#A1784A'; ctx.beginPath(); ctx.ellipse(0,-1,15,5,0,0,Math.PI); ctx.lineTo(-15,-3); ctx.fill(); ctx.strokeStyle='#7A5530'; ctx.lineWidth=1; for(let k=-12;k<=12;k+=4){ ctx.beginPath(); ctx.moveTo(k,-3); ctx.lineTo(k+3,2); ctx.stroke(); } ctx.restore(); }
  else if(THEME==='carnaval'){ // three balloons in rood-geel-groen tied to the KASSA sign
    CARN.forEach((c,i)=>{ const bx=x+12+i*20, by=y-46-(i===1?8:0)+Math.sin(t*0.05+i)*2; ctx.strokeStyle='#5a4444'; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(bx,by+11); ctx.lineTo(x+32,y-4); ctx.stroke(); ctx.fillStyle=c; ctx.beginPath(); ctx.ellipse(bx,by,8,10,0,0,Math.PI*2); ctx.fill(); ctx.fillStyle='rgba(255,255,255,.5)'; ctx.beginPath(); ctx.ellipse(bx-3,by-4,2,3,-0.4,0,Math.PI*2); ctx.fill(); }); }
  else if(THEME==='kerst'){ // a small Christmas tree on the right
    ctx.save(); ctx.translate(x+88,y+64); ctx.fillStyle='#6B3A1E'; ctx.fillRect(-4,-8,8,8);
    for(const [w,yy] of [[18,-8],[14,-22],[10,-34]]){ ctx.fillStyle='#2E7D32'; ctx.beginPath(); ctx.moveTo(-w,yy); ctx.lineTo(w,yy); ctx.lineTo(0,yy-18); ctx.closePath(); ctx.fill(); }
    [[-9,-12,'#D20000'],[7,-15,'#FCB900'],[-4,-27,'#1E88E5'],[5,-38,'#D20000']].forEach(([bx,by,c],i)=>{ ctx.globalAlpha=0.7+0.3*Math.sin(t*0.08+i*1.7); ctx.fillStyle=c; ctx.beginPath(); ctx.arc(bx,by,2.6,0,Math.PI*2); ctx.fill(); }); ctx.globalAlpha=1;
    ctx.fillStyle='#FCB900'; ctx.beginPath(); for(let k=0;k<10;k++){ const a=-Math.PI/2+k*Math.PI/5, r=k%2?2.4:6; ctx.lineTo(Math.cos(a)*r,-52+Math.sin(a)*r); } ctx.closePath(); ctx.fill(); ctx.restore(); } }
/* snow (kerst) on top of any game, in screen space; stateless (a function of the frame counter) so step() stays deterministic */
const REDUCED=!!(typeof window!=='undefined'&&window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches);
function drawSeason(t){
  if(THEME==='sint'){ // now and then a few pepernoten are strooid from the top
    const n=REDUCED?5:12, sp=REDUCED?0.4:1; ctx.save();
    for(let i=0;i<n;i++){ const y=((i*131.7+t*(0.9+(i%4)*0.25)*sp)%(H*2.2))-20; if(y>H+10) continue; const x=(((i*211.3+Math.sin(t*0.02+i)*12)%W)+W)%W;
      ctx.fillStyle='#A0632F'; ctx.beginPath(); ctx.arc(x,y,4.2,0,Math.PI*2); ctx.fill(); ctx.strokeStyle='#5C3317'; ctx.lineWidth=0.8; ctx.stroke(); ctx.fillStyle='rgba(255,220,170,.5)'; ctx.beginPath(); ctx.arc(x-1.3,y-1.3,1.2,0,Math.PI*2); ctx.fill(); }
    ctx.restore(); return; }
  if(THEME==='pasen'){ // blossom petals drifting down
    const n=REDUCED?14:36, sp=REDUCED?0.35:1; ctx.save();
    for(let i=0;i<n;i++){ const y=((i*83.1+t*(0.45+(i%4)*0.12)*sp)%(H+20))-10, x=(((i*157.3+Math.sin(t*0.02*sp+i)*30)%W)+W)%W, a=Math.sin(t*0.03*sp+i)*1.2+i;
      ctx.save(); ctx.translate(x,y); ctx.rotate(a); ctx.fillStyle=i%3?'#F8BBD0':'#FFFFFF'; ctx.strokeStyle='rgba(216,120,160,.6)'; ctx.lineWidth=0.7; ctx.beginPath(); ctx.ellipse(0,0,4.5,2.6,0,0,Math.PI*2); ctx.fill(); ctx.stroke(); ctx.restore(); }
    ctx.restore(); return; }
  if(THEME==='carnaval'){ // confetti, spinning slowly down
    const n=REDUCED?20:56, sp=REDUCED?0.35:1; ctx.save();
    for(let i=0;i<n;i++){ const y=((i*61.3+t*(0.6+(i%5)*0.18)*sp)%(H+20))-10, x=(((i*137.9+Math.sin(t*0.015*sp+i)*22)%W)+W)%W, a=t*0.05*sp*(i%2?1:-1)+i;
      ctx.save(); ctx.translate(x,y); ctx.rotate(a); ctx.scale(1,Math.abs(Math.cos(a*1.3))+0.2); ctx.fillStyle=[...CARN,'#9B51E0','#1E88E5','#F78DA7'][i%6]; ctx.fillRect(-3,-2,6,4); ctx.restore(); }
    ctx.restore(); return; }
  if(THEME!=='kerst') return; const n=REDUCED?24:70, sp=REDUCED?0.35:1; ctx.save(); ctx.fillStyle='#fff'; ctx.strokeStyle='rgba(120,150,195,.75)'; ctx.lineWidth=0.8; // outlined, so the flakes also show on the light shop walls
  for(let i=0;i<n;i++){ const sz=1.2+(i%3)*0.9, vy=(0.35+(i%5)*0.12)*sp, y=((i*53.7+t*vy)%(H+20))-10, x=(((i*97.3+Math.sin(t*0.012*sp+i)*18)%W)+W)%W;
    ctx.globalAlpha=0.6+0.1*(i%4); ctx.beginPath(); ctx.arc(x,y,sz,0,Math.PI*2); ctx.fill(); ctx.stroke(); }
  ctx.restore(); }
